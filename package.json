{
  "name": "typeship",
  "version": "1.0.0",
  "description": "TypeScript SDK + CLI + MCP server for typeship. Generated by typeship.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "typeship": "./dist/cli.js",
    "typeship-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "src",
    "api.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}

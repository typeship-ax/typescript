{
  "name": "typeship",
  "version": "1.0.0",
  "description": "TypeScript SDK + CLI + MCP server for typeship. Generated by typeship.",
  "keywords": [
    "typeship",
    "sdk",
    "api",
    "api-client",
    "client",
    "typescript",
    "openapi",
    "cli",
    "mcp",
    "mcp-server",
    "typed"
  ],
  "homepage": "https://typeship.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanburke/typeship.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "typeship": "./dist/cli.js",
    "typeship-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "src",
    "api.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
